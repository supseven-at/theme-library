{
    "name": "supseven/theme-library",
    "license": "GPL-2.0-only",
    "description": "Helper library for TYPO3 projects",
    "type": "typo3-cms-extension",
    "autoload": {
        "psr-4": {
            "Supseven\\ThemeLibrary\\": "Classes"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "friendsofphp/php-cs-fixer": "^3.62",
        "mikey179/vfsstream": "^1.6",
        "typo3fluid/fluid": "^4.0 || ^5.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Supseven\\ThemeLibrary\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "theme_library"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": false,
            "typo3/class-alias-loader": false,
            "php-http/discovery": false
        }
    }
}
